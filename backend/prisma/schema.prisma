// Rooma — Prisma Schema
// Mirrors database/rooma-schema.sql

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  seeker
  landlord
  agent
  hotel_manager
  admin
}

enum ListingType {
  hostel
  hotel
  rental
  sale
}

enum ListingStatus {
  draft
  pending_review
  active
  inactive
  archived
}

enum MediaType {
  image
  video
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
  completed
}

enum PaymentProvider {
  mtn_momo
  telecel_cash
  paypal
  bank
  stripe
}

enum PaymentStatus {
  pending
  successful
  failed
  refunded
}

model User {
  id               String    @id @default(uuid())
  fullName         String    @map("full_name")
  email            String?   @unique
  phoneNumber      String    @unique @map("phone_number")
  passwordHash     String    @map("password_hash")
  role             UserRole  @default(seeker)
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  profilePhotoUrl  String?   @map("profile_photo_url")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  listings         Listing[]
  bookings         Booking[]
  savedListings    SavedListing[]
  ratings          Rating[]
  smsVerifications SmsVerification[]

  @@map("users")
}

model SmsVerification {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  purpose    String    @default("signup")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("sms_verifications")
}

model University {
  id            String   @id @default(uuid())
  name          String
  city          String?
  region        String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now()) @map("created_at")

  hostelDetails HostelDetails[]

  @@map("universities")
}

model Listing {
  id              String        @id @default(uuid())
  ownerId         String        @map("owner_id")
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type            ListingType
  title           String
  description     String?
  price           Decimal       @db.Decimal(12, 2)
  currency        String        @default("GHS")
  priceNegotiable Boolean       @default(false) @map("price_negotiable")
  status          ListingStatus @default(draft)
  address         String?
  latitude        Float?
  longitude       Float?
  averageRating   Decimal?      @default(0) @map("average_rating") @db.Decimal(3, 2)
  ratingCount     Int           @default(0) @map("rating_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  hostelDetails   HostelDetails?
  hotelDetails    HotelDetails?
  rentalDetails   RentalDetails?
  saleDetails     SaleDetails?
  roomTypes       RoomType[]
  media           ListingMedia[]
  documents       ListingDocument[]
  ownerVerification OwnerVerification[]
  bookings        Booking[]
  ratings         Rating[]
  savedBy         SavedListing[]

  @@map("listings")
}

model HostelDetails {
  listingId           String      @id @map("listing_id")
  listing             Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  universityId         String?     @map("university_id")
  university           University? @relation(fields: [universityId], references: [id])
  roomType             String?     @map("room_type")
  capacity             Int?
  distanceToCampusKm   Decimal?    @map("distance_to_campus_km") @db.Decimal(5, 2)

  @@map("hostel_details")
}

model HotelDetails {
  listingId  String   @id @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  starRating Int?     @map("star_rating")
  amenities  String[]

  @@map("hotel_details")
}

model RoomType {
  id                 String   @id @default(uuid())
  listingId          String   @map("listing_id")
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name               String
  pricePerNight      Decimal  @map("price_per_night") @db.Decimal(12, 2)
  capacity           Int      @default(1)
  quantityAvailable  Int      @default(1) @map("quantity_available")
  createdAt          DateTime @default(now()) @map("created_at")

  bookings           Booking[]

  @@map("room_types")
}

model RentalDetails {
  listingId String  @id @map("listing_id")
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bedrooms  Int?
  bathrooms Int?
  leaseTerm String? @map("lease_term")
  furnished Boolean @default(false)

  @@map("rental_details")
}

model SaleDetails {
  listingId          String  @id @map("listing_id")
  listing            Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bedrooms           Int?
  bathrooms          Int?
  landSizeSqm        Decimal? @map("land_size_sqm") @db.Decimal(10, 2)
  ownershipVerified  Boolean  @default(false) @map("ownership_verified")

  @@map("sale_details")
}

model ListingDocument {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  docType    String   @map("doc_type")
  fileUrl    String   @map("file_url")
  verified   Boolean  @default(false)
  verifiedBy String?  @map("verified_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@map("listing_documents")
}

model OwnerVerification {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  selfieUrl  String   @map("selfie_url")
  verified   Boolean  @default(false)
  capturedAt DateTime @default(now()) @map("captured_at")

  @@map("owner_verifications")
}

model ListingMedia {
  id            String    @id @default(uuid())
  listingId     String    @map("listing_id")
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mediaType     MediaType @map("media_type")
  url           String
  displayOrder  Int       @default(0) @map("display_order")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("listing_media")
}

model SavedListing {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@id([userId, listingId])
  @@map("saved_listings")
}

model Rating {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listingId, userId])
  @@map("ratings")
}

model Booking {
  id           String        @id @default(uuid())
  listingId    String        @map("listing_id")
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  roomTypeId   String?       @map("room_type_id")
  roomType     RoomType?     @relation(fields: [roomTypeId], references: [id])
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn      DateTime?     @map("check_in") @db.Date
  checkOut     DateTime?     @map("check_out") @db.Date
  status       BookingStatus @default(pending)
  confirmedBy  String?       @map("confirmed_by")
  confirmedAt  DateTime?     @map("confirmed_at")
  totalAmount  Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency     String        @default("GHS")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  payments     Payment[]

  @@map("bookings")
}

model Payment {
  id                 String          @id @default(uuid())
  bookingId          String          @map("booking_id")
  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("GHS")
  provider           PaymentProvider
  status             PaymentStatus   @default(pending)
  providerReference  String?         @map("provider_reference")
  receiptUrl         String?         @map("receipt_url")
  paidAt             DateTime?       @map("paid_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@map("payments")
}
